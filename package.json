{
  "name": "dsh-a-share-screener",
  "version": "0.1.0",
  "description": "A-share stock screening plugin for DeepSeek Harness (dsh): pluggable strategies on a free Eastmoney data source, behind an extensible data-source abstraction.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx/esm src/cli.ts",
    "sync": "node --import tsx/esm src/cli.ts sync",
    "scan": "node --import tsx/esm src/cli.ts scan",
    "strategies": "node --import tsx/esm src/cli.ts strategies",
    "sources": "node --import tsx/esm src/cli.ts sources"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22",
    "tsdown": "^0.12.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "tsx": "^4.19.0"
  }
}
